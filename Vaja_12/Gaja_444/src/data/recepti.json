[
{"id":"1","ime":"Rižota z bučkami","cas":30,"sestavine":[{"id":"riz","ime":"Riž","kolicina":"150 g"},{"id":"bucke","ime":"Bučke","kolicina":"1 kos"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"parmezan","ime":"Parmezan","kolicina":"30 g"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"}],"koraki":["Na olju popraži sesekljano čebulo in na kocke narezano bučko.","Dodaj riž in postopoma prilivaj vročo vodo, dokler se riž ne zmehča.","Vmešaj parmezan in postrezi."]},
{"id":"2","ime":"Testenine s paradižnikom","cas":20,"sestavine":[{"id":"testenine","ime":"Testenine","kolicina":"200 g"},{"id":"paradiznik","ime":"Paradižnik","kolicina":"300 g"},{"id":"cesen","ime":"Česen","kolicina":"2 stroka"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"}],"koraki":["Testenine skuhaj po navodilih na embalaži.","Na olju popraži česen in narezan paradižnik ter duši 10 minut.","Zmešaj omako s testeninami."]},
{"id":"3","ime":"Omleta s sirom","cas":10,"sestavine":[{"id":"jajca","ime":"Jajca","kolicina":"3 kosi"},{"id":"sir","ime":"Sir","kolicina":"50 g"},{"id":"maslo","ime":"Maslo","kolicina":"10 g"}],"koraki":["Jajca razžvrkljaj.","V ponvi stopi maslo in vlij jajca.","Posuj s sirom, prepogni omleto in postrezi."]},
{"id":"4","ime":"Pečen krompir s piščancem","cas":60,"sestavine":[{"id":"krompir","ime":"Krompir","kolicina":"400 g"},{"id":"piscanec","ime":"Piščanec","kolicina":"300 g"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"},{"id":"cesen","ime":"Česen","kolicina":"2 stroka"},{"id":"rozmarin","ime":"Rožmarin","kolicina":"1 žlička"}],"koraki":["Krompir nareži, zmešaj z oljem, česnom in rožmarinom.","Krompir in piščanca razporedi po pekaču.","Peci pri 200 °C približno 45–50 minut, da je piščanec povsem pečen."]},
{"id":"5","ime":"Palačinke","cas":25,"sestavine":[{"id":"moka","ime":"Moka","kolicina":"200 g"},{"id":"mleko","ime":"Mleko","kolicina":"350 ml"},{"id":"jajca","ime":"Jajca","kolicina":"2 kosa"},{"id":"maslo","ime":"Maslo","kolicina":"20 g"}],"koraki":["Zmešaj moko, mleko in jajca v gladko maso.","Segrej ponev z malo masla.","Speci tanke palačinke na obeh straneh."]},
{"id":"6","ime":"Korenčkova juha","cas":35,"sestavine":[{"id":"korenje","ime":"Korenje","kolicina":"400 g"},{"id":"krompir","ime":"Krompir","kolicina":"150 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"smetana","ime":"Smetana","kolicina":"100 ml"}],"koraki":["Nareži zelenjavo in jo zalij z vodo.","Kuhaj približno 25 minut do mehkega.","Zmešaj s paličnim mešalnikom in dodaj smetano."]},
{"id":"7","ime":"Solata s tuno","cas":10,"sestavine":[{"id":"tuna","ime":"Tuna","kolicina":"1 konzerva"},{"id":"solata","ime":"Zelena solata","kolicina":"100 g"},{"id":"paradiznik","ime":"Paradižnik","kolicina":"2 kosa"},{"id":"koruza","ime":"Koruza","kolicina":"80 g"},{"id":"olje","ime":"Olivno olje","kolicina":"1 žlica"}],"koraki":["Operi solato in nareži paradižnik.","Dodaj odcejeno tuno in koruzo.","Prelij z oljem in premešaj."]},
{"id":"8","ime":"Kremne testenine s piščancem","cas":30,"sestavine":[{"id":"testenine","ime":"Testenine","kolicina":"200 g"},{"id":"piscanec","ime":"Piščanec","kolicina":"200 g"},{"id":"smetana","ime":"Smetana","kolicina":"150 ml"},{"id":"cesen","ime":"Česen","kolicina":"2 stroka"},{"id":"parmezan","ime":"Parmezan","kolicina":"30 g"}],"koraki":["Skuhaj testenine.","Na ponvi popeci na koščke narezanega piščanca do popolne pečenosti in dodaj česen.","Vlij smetano, primešaj testenine in parmezan."]},
{"id":"9","ime":"Bučkini polpeti","cas":30,"sestavine":[{"id":"bucke","ime":"Bučke","kolicina":"300 g"},{"id":"jajca","ime":"Jajca","kolicina":"1 kos"},{"id":"moka","ime":"Moka","kolicina":"60 g"},{"id":"sir","ime":"Sir","kolicina":"50 g"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"}],"koraki":["Naribaj bučke in iztisni odvečno tekočino.","Dodaj jajce, moko in nariban sir.","Oblikuj polpete in jih popeci na olju."]},
{"id":"10","ime":"Pražen riž z jajcem","cas":15,"sestavine":[{"id":"riz","ime":"Riž","kolicina":"200 g kuhanega"},{"id":"jajca","ime":"Jajca","kolicina":"2 kosa"},{"id":"korenje","ime":"Korenje","kolicina":"1 kos"},{"id":"grah","ime":"Grah","kolicina":"80 g"},{"id":"sojina","ime":"Sojina omaka","kolicina":"2 žlici"}],"koraki":["Na vroči ponvi popraži narezano korenje in grah.","Dodaj razžvrkljani jajci in mešaj, da zakrkneta.","Primešaj kuhan riž in sojino omako ter dobro segrej."]},
{"id":"11","ime":"Paradižnikova juha","cas":25,"sestavine":[{"id":"paradiznik","ime":"Paradižnik","kolicina":"500 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"cesen","ime":"Česen","kolicina":"2 stroka"},{"id":"olje","ime":"Olivno olje","kolicina":"1 žlica"}],"koraki":["Na olju popraži čebulo in česen.","Dodaj narezan paradižnik in malo vode ter kuhaj 20 minut.","Juho zmešaj do gladkega."]},
{"id":"12","ime":"Krompirjeva solata","cas":35,"sestavine":[{"id":"krompir","ime":"Krompir","kolicina":"400 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"kis","ime":"Kis","kolicina":"2 žlici"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"}],"koraki":["Krompir skuhaj do mehkega in nareži na rezine.","Dodaj tanko narezano čebulo.","Prelij s kisom in oljem ter premešaj."]},
{"id":"13","ime":"Banana ovsena kaša","cas":10,"sestavine":[{"id":"ovseni","ime":"Ovseni kosmiči","kolicina":"60 g"},{"id":"mleko","ime":"Mleko","kolicina":"200 ml"},{"id":"banana","ime":"Banana","kolicina":"1 kos"},{"id":"med","ime":"Med","kolicina":"1 žlička"}],"koraki":["Kosmiče kuhaj v mleku 5–7 minut.","Dodaj narezano banano.","Prelij z medom."]},
{"id":"14","ime":"Pečena cvetača","cas":40,"sestavine":[{"id":"cvetača","ime":"Cvetača","kolicina":"500 g"},{"id":"olje","ime":"Olivno olje","kolicina":"2 žlici"},{"id":"cesen","ime":"Česen","kolicina":"2 stroka"},{"id":"parmezan","ime":"Parmezan","kolicina":"30 g"}],"koraki":["Cvetačo razdeli na cvetke in zmešaj z oljem ter česnom.","Peci pri 200 °C približno 30 minut.","Potresi s parmezanom in postrezi."]},
{"id":"15","ime":"Solata caprese","cas":10,"sestavine":[{"id":"paradiznik","ime":"Paradižnik","kolicina":"2 kosa"},{"id":"mocarela","ime":"Mocarela","kolicina":"125 g"},{"id":"bazilika","ime":"Bazilika","kolicina":"8 listov"},{"id":"olje","ime":"Olivno olje","kolicina":"1 žlica"}],"koraki":["Paradižnik in mocarelo nareži na rezine.","Izmenično jih položi na krožnik z baziliko.","Pokapaj z oljem."]},
{"id":"16","ime":"Piščančje tortilje","cas":25,"sestavine":[{"id":"tortilje","ime":"Tortilje","kolicina":"4 kosi"},{"id":"piscanec","ime":"Piščanec","kolicina":"250 g"},{"id":"paprika","ime":"Paprika","kolicina":"1 kos"},{"id":"sir","ime":"Sir","kolicina":"80 g"},{"id":"solata","ime":"Zelena solata","kolicina":"60 g"}],"koraki":["Nareži piščanca in papriko ter ju popeci do popolne pečenosti mesa.","Segrej tortilje.","Napolni jih z mesom, papriko, sirom in solato ter zavij."]},
{"id":"17","ime":"Testenine s tuno","cas":20,"sestavine":[{"id":"testenine","ime":"Testenine","kolicina":"200 g"},{"id":"tuna","ime":"Tuna","kolicina":"1 konzerva"},{"id":"paradiznik","ime":"Paradižnik","kolicina":"200 g"},{"id":"cesen","ime":"Česen","kolicina":"1 strok"}],"koraki":["Skuhaj testenine.","Na ponvi duši česen in paradižnik, nato dodaj tuno.","Primešaj odcejene testenine."]},
{"id":"18","ime":"Zelenjavna rižota","cas":35,"sestavine":[{"id":"riz","ime":"Riž","kolicina":"180 g"},{"id":"korenje","ime":"Korenje","kolicina":"1 kos"},{"id":"grah","ime":"Grah","kolicina":"100 g"},{"id":"paprika","ime":"Paprika","kolicina":"1 kos"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"}],"koraki":["Popraži narezano zelenjavo.","Dodaj riž in vodo ter kuhaj do mehkega.","Premešaj in postrezi toplo."]},
{"id":"19","ime":"Jajčni sendvič","cas":15,"sestavine":[{"id":"kruh","ime":"Kruh","kolicina":"4 rezine"},{"id":"jajca","ime":"Jajca","kolicina":"2 kosa"},{"id":"jogurt","ime":"Jogurt","kolicina":"2 žlici"},{"id":"solata","ime":"Zelena solata","kolicina":"4 listi"}],"koraki":["Jajci trdo skuhaj in olupi.","Pretlači ju z jogurtom.","Namaži kruh in dodaj solato."]},
{"id":"20","ime":"Kremna brokolijeva juha","cas":30,"sestavine":[{"id":"brokoli","ime":"Brokoli","kolicina":"350 g"},{"id":"krompir","ime":"Krompir","kolicina":"150 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"smetana","ime":"Smetana","kolicina":"100 ml"}],"koraki":["Zelenjavo nareži in skuhaj v vodi.","Ko je mehka, jo pretlači s paličnim mešalnikom.","Vmešaj smetano in na kratko pogrej."]},
{"id":"21","ime":"Francoski toast","cas":15,"sestavine":[{"id":"kruh","ime":"Kruh","kolicina":"4 rezine"},{"id":"jajca","ime":"Jajca","kolicina":"2 kosa"},{"id":"mleko","ime":"Mleko","kolicina":"100 ml"},{"id":"maslo","ime":"Maslo","kolicina":"15 g"},{"id":"med","ime":"Med","kolicina":"1 žlica"}],"koraki":["Razžvrkljaj jajci z mlekom.","Kruh pomoči v zmes in popeci na maslu z obeh strani.","Postrezi z medom."]},
{"id":"22","ime":"Pečene polnjene paprike","cas":55,"sestavine":[{"id":"paprika","ime":"Paprika","kolicina":"3 kosi"},{"id":"riz","ime":"Riž","kolicina":"150 g kuhanega"},{"id":"paradiznik","ime":"Paradižnik","kolicina":"2 kosa"},{"id":"sir","ime":"Sir","kolicina":"100 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"}],"koraki":["Paprike prereži in odstrani semena.","Zmešaj kuhan riž, nasekljan paradižnik, čebulo ter sir in napolni paprike.","Peci pri 190 °C približno 35 minut."]},
{"id":"23","ime":"Jabolčni drobljenec","cas":45,"sestavine":[{"id":"jabolko","ime":"Jabolko","kolicina":"3 kosi"},{"id":"moka","ime":"Moka","kolicina":"100 g"},{"id":"maslo","ime":"Maslo","kolicina":"70 g"},{"id":"sladkor","ime":"Sladkor","kolicina":"40 g"},{"id":"cimet","ime":"Cimet","kolicina":"1 žlička"}],"koraki":["Jabolka nareži in posuj s cimetom.","Moko, maslo in sladkor s prsti zdrobi ter razporedi po jabolkih.","Peci pri 180 °C približno 30 minut."]},
{"id":"24","ime":"Hrustljavi krompirjevi polpeti","cas":35,"sestavine":[{"id":"krompir","ime":"Krompir","kolicina":"400 g"},{"id":"jajca","ime":"Jajca","kolicina":"1 kos"},{"id":"moka","ime":"Moka","kolicina":"40 g"},{"id":"cebula","ime":"Čebula","kolicina":"1 kos"},{"id":"olje","ime":"Olivno olje","kolicina":"3 žlice"}],"koraki":["Naribaj krompir in čebulo ter iztisni tekočino.","Zmešaj z jajcem in moko.","Oblikuj tanke polpete in jih popeci na obeh straneh."]},
{"id":"25","ime":"Jogurt z banano in ovsenimi kosmiči","cas":5,"sestavine":[{"id":"jogurt","ime":"Jogurt","kolicina":"200 g"},{"id":"banana","ime":"Banana","kolicina":"1 kos"},{"id":"ovseni","ime":"Ovseni kosmiči","kolicina":"40 g"},{"id":"med","ime":"Med","kolicina":"1 žlička"}],"koraki":["V skledo daj jogurt in ovsene kosmiče.","Dodaj narezano banano.","Prelij z medom in postrezi."]}
]
